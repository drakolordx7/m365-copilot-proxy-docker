# Copy to .env for local docker compose (never commit .env).

# Required for any non-trusted network. Clients send this as
# Authorization: Bearer … or X-API-Key: …
M365_API_KEY=change-me-to-a-long-random-secret

# oauth | secrets | auto
M365_AUTH_MODE=oauth

# Comma-separated browser origins, or leave empty for restrictive default
# M365_CORS_ORIGIN=http://localhost:3000

# Set to 0 to disable Cursor Ask/Plan/Agent adaptations
# M365_CURSOR_COMPAT=1

# Production: leave debug off (debug.log can contain prompts/tools)
M365_DEBUG=0
